<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_navigation"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.firstinubuntu.fragments.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home" />
    <fragment
        android:id="@+id/allFragment"
        android:name="com.example.firstinubuntu.fragments.AllFragment"
        android:label="fragment_all"
        tools:layout="@layout/fragment_all">
        <action
            android:id="@+id/action_allFragment_to_showFragment"
            app:destination="@id/showFragment" />
    </fragment>
    <fragment
        android:id="@+id/natureFragment"
        android:name="com.example.firstinubuntu.fragments.NatureFragment"
        android:label="fragment_nature"
        tools:layout="@layout/fragment_nature">
        <action
            android:id="@+id/action_natureFragment_to_showFragment"
            app:destination="@id/showFragment" />
    </fragment>
    <fragment
        android:id="@+id/randomFragment"
        android:name="com.example.firstinubuntu.fragments.RandomFragment"
        android:label="fragment_random"
        tools:layout="@layout/fragment_random">
        <action
            android:id="@+id/action_randomFragment_to_showFragment"
            app:destination="@id/showFragment" />
    </fragment>
    <fragment
        android:id="@+id/likeFragment"
        android:name="com.example.firstinubuntu.fragments.LikeFragment"
        android:label="fragment_like"
        tools:layout="@layout/fragment_like">
        <action
            android:id="@+id/action_likeFragment_to_showFragment"
            app:destination="@id/showFragment" />
    </fragment>
    <fragment
        android:id="@+id/showFragment"
        android:name="com.example.firstinubuntu.fragments.ShowFragment"
        android:label="fragment_show"
        tools:layout="@layout/fragment_show"/>
</navigation>